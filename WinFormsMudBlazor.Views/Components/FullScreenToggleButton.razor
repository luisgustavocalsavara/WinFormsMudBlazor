<MudTooltip Text="@Tooltip">
    <MudIconButton Icon="@CurrentIcon"
                   OnClick="ToggleFullScreen"
                   Size="Size.Medium"
                   Color="Color.Primary"
                   Class="@(_animate ? "fullscreen-icon animate" : "fullscreen-icon")" />
</MudTooltip>

@code {
    [Parameter] public bool IsFullScreen { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }

    private bool _animate;
    private string CurrentIcon => IsFullScreen ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen;
    private string Tooltip => IsFullScreen ? "Exit Fullscreen (Esc)" : "Enter Fullscreen (F11)";

    private async Task ToggleFullScreen()
    {
        _animate = true;
        await OnToggle.InvokeAsync();
        await Task.Delay(300);
        _animate = false;
        StateHasChanged();
    }
}
